# =============================================================================
# LLM Provider Configuration
# =============================================================================

# Explicit provider selection (optional - auto-detects from API keys if not set)
# Options: claude, openai, ollama, zhipu, lmstudio
LLM_PROVIDER=ollama

# Optional: Override the default model for selected provider
# LLM_MODEL=codellama:13b

# =============================================================================
# Provider API Keys (set the one matching your LLM_PROVIDER)
# =============================================================================

# Claude API Key (for claude provider)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API Key (for openai provider)
# OPENAI_API_KEY=sk-...

# ZHIPU API Key (for zhipu/GLM provider)
# ZHIPU_API_KEY=your-api-key-here
# ZHIPU_BASE_URL=https://api.z.ai/api/coding/paas/v4

# =============================================================================
# Ollama Configuration (for local development - no API key needed)
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434

# Recommended Ollama models for UI generation:
# - codellama:13b     (best for code, ~8GB VRAM)
# - deepseek-coder:6.7b (lighter, ~4GB VRAM)
# - qwen2.5-coder:7b  (good structure following)
# - llama3.2         (general purpose)

# =============================================================================
# LM Studio Configuration (for local development - no API key needed)
# =============================================================================
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LLM_PROVIDER=lmstudio
# LLM_MODEL=devstral-small-2

# Recommended LM Studio models for UI generation:
# - devstral-small-2  (Mistral's code model, excellent for UI generation)

# =============================================================================
# PocketBase Configuration (for persistence layer)
# =============================================================================
# PocketBase server URL for syncing conversations, messages, and generations
# Default: http://127.0.0.1:8090 (local development)
# POCKETBASE_URL=http://127.0.0.1:8090

# For SvelteKit (client-side accessible):
# PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Options:
# - Local: Run `./pocketbase serve` and use http://127.0.0.1:8090
# - PocketHost.io: Free hosting at https://pockethost.io (e.g., https://your-app.pockethost.io)
# - Self-hosted: Deploy to any VPS with your domain

# =============================================================================
# Development Settings
# =============================================================================
DEV_INFO=true
